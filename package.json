{
  "name": "educa-navarra-mcp",
  "version": "1.0.0",
  "description": "Conector MCP no oficial para que Claude (u otra IA) meta las notas de evaluación en Educa (Gobierno de Navarra) desde tu Excel o CSV.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "educa",
    "navarra",
    "notas",
    "calificaciones",
    "docentes",
    "lomloe",
    "playwright"
  ],
  "license": "MIT",
  "author": "vTanco (https://github.com/vTanco)",
  "homepage": "https://github.com/vTanco/educa-navarra-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vTanco/educa-navarra-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/vTanco/educa-navarra-mcp/issues"
  },
  "type": "module",
  "bin": {
    "educa-navarra-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "educa.config.example.json",
    "AVISO-LEGAL.md"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "mock": "tsx scripts/mock-server.ts",
    "test": "tsx scripts/unit.ts",
    "smoke": "tsx scripts/smoke.ts",
    "pack:mcpb": "node scripts/pack-mcpb.mjs",
    "prepublishOnly": "npm run build && npm test"
  },
  "engines": {
    "node": ">=20.3"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "exceljs": "^4.4.0",
    "playwright": "^1.63.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "@anthropic-ai/mcpb": "2.1.2"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
